doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    //- O título será preenchido dinamicamente pelo backend
    title #{product.name} | Catálogo de Pragas - PestControl Pro
    style.
      :root {
          --primary-color: #2a7a3e; --secondary-color: #ff9800; --dark-color: #333333;
          --light-color: #f4f4f4; --background-color: #ffffff; --border-color: #ddd;
          --danger-color: #dc3545; --info-color: #007bff;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          line-height: 1.6; color: var(--dark-color); background-color: var(--light-color);
      }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
      .btn {
          display: inline-block; padding: 10px 24px; color: #fff; text-decoration: none; 
          border-radius: 5px; font-weight: bold; transition: background-color 0.3s ease; 
          cursor: pointer; border: none; font-size: 1rem;
      }
      .main-header { background-color: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
      .main-nav { display: flex; justify-content: space-between; align-items: center; height: 70px; }
      .main-nav .logo { font-size: 1.5rem; font-weight: bold; color: var(--primary-color); text-decoration: none; }
      .main-nav ul { list-style: none; display: flex; align-items: center; }
      .main-nav ul li { margin-left: 20px; }
      .main-nav ul a { text-decoration: none; color: var(--dark-color); font-weight: 500; }
      .main-nav ul a.logout-btn { color: var(--secondary-color); font-weight: bold; }
      
      /* --- Estilos para Usuário Logado (Adicionado) --- */
      .user-greeting { margin-right: 15px; font-weight: 500; }
      a.logout-btn {
          background-color: var(--primary-color); color: #fff; padding: 8px 16px;
          border-radius: 5px; font-weight: bold;
      }
      a.logout-btn:hover { background-color: #1e5a2d; color: #fff; }
      
      main { padding: 60px 0; }
      .pest-detail-layout {
          display: grid; grid-template-columns: 1fr 1.5fr;
          gap: 40px; align-items: flex-start;
      }
      .gallery-container {
        width: 100%;
      }
      .gallery-main-image{
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        background-color: #eee;
        margin-bottom: 15px;
        border: 1px solid var(--border-color);
      }
      .gallery-thumbnails {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 10px;
      }
      .gallery-thumbnail {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 5px;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.3s ease, transform 0.3s ease;
      }
      .gallery-thumbnail:hover {
        transform: scale(1.05);
        border-color: var(--primary-color);
      }
      .gallery-thumbnail.active {
        border-color: var(--primary-color);
        box-shadow: 0 0 10px rgba(42, 122, 62, 0.5);
      }

      .pest-info .pest-title { font-size: 2.5rem; margin-bottom: 5px; color: var(--dark-color); }
      .pest-info .pest-scientific-name { font-size: 1.2rem; font-style: italic; color: #666; margin-bottom: 30px; display: block; }
      .detail-section { margin-bottom: 30px; }
      .detail-section h3 {
          font-size: 1.3rem; color: var(--primary-color); margin-bottom: 10px;
          padding-bottom: 5px; border-bottom: 2px solid var(--border-color);
      }
      
      /* --- NOVO ESTILO ADICIONADO --- */
      .detail-link {
        display: inline-block;
        background-color: var(--primary-color);
        color: #fff;
        padding: 5px 12px;
        border-radius: 15px; /* Deixa com formato de "pílula" */
        text-decoration: none;
        font-weight: 500;
        transition: background-color 0.3s ease;
      }
      .detail-link:hover {
        background-color: #1e5a2d; /* Verde mais escuro no hover */
        color: #fff;
      }

      .admin-actions {
          margin-top: 30px; padding: 20px; background-color: #f9f9f9;
          border-radius: 8px; border: 1px solid var(--border-color); display: flex; gap: 15px; align-items: center;
      }
      .btn-edit { background-color: var(--info-color); }
      .btn-edit:hover { background-color: #0056b3; }
      .btn-delete { background-color: var(--danger-color); }
      .btn-delete:hover { background-color: #c82333; }
      .main-footer { background-color: var(--dark-color); color: #fff; text-align: center; padding: 30px 0; margin-top: 60px; }

      @media (max-width: 800px) {
         .pest-detail-layout { grid-template-columns: 1fr; }
        }

      @media (max-width: 768px) {
          h1, .pest-info .pest-title { font-size: 2.2rem; }
          h2 { font-size: 1.8rem; }
          .main-nav { flex-direction: column; height: auto; padding: 15px 0; }
          .main-nav ul { margin-top: 15px; flex-direction: column; align-items: center; gap: 10px; }
          .main-nav ul li { margin: 10px 0; margin-left: 0; }
          .admin-actions { flex-direction: column; align-items: stretch; } /* Empilha botões de admin */
          .admin-actions form, .admin-actions a { width: 100%; }
          .admin-actions button, .admin-actions a { width: 100%; text-align: center; }
      }

  body
    header.main-header
      nav.main-nav.container
        a(href="/").logo PestControl Pro
        ul
          if session && session.usuario && session.usuario.funcao ==='admin'
            li: a(href="/dashboardadmin") Dashboard
            li: a(href="/products/new") Nova Praga
            li: a(href="/metodo/new") Novo Método
            li: a(href="/categoria/new") Nova Categoria

          li: a(href="/nossosprodutos") Pragas
          li: a(href="/nossascategorias") Categorias
          li: a(href="/nossosmetodos") Métodos

          if !session.usuario
            li: a(href="/login").btn Entrar
          else
            li.user-greeting Olá, #{session.usuario.usuario}!
            li: a(href="/logout").logout-btn Sair


    main
      .container
        .pest-detail-layout
          .gallery-container 
            img(src=(gallery.length>0 ? gallery[0] : "http://placehold.co/400x300/f0f0f0/aaa?text=N/A"), alt=product.name, id="galleryMainImage").gallery-main-image

            if gallery.length > 1
              .gallery-thumbnails 
                each imageUrl, index in gallery 
                  img(src=imageUrl, alt='Visualização' + (index +1)).gallery-thumbnail(class=(index === 0 ? 'active' : ''))

          // Coluna de Informações
          .pest-info
            h1.pest-title= product.name
            span.pest-scientific-name= product.name2

            .detail-section
              h3 Descrição
              p= product.description
            
            .detail-section
              h3 Ciclo de Vida
              p= product.life_cycle
            
            .detail-section
              h3 Danos e Riscos
              p= product.damage
            
            if metodo && metodo.id 
              .detail-section 
              h3 Método 
              a(href="/metodo/" + metodo.id).detail-link #{metodo.name}

            if categoria && categoria.id 
              .detail-section 
              h3 Categoria 
              a(href="/categoria/" + categoria.id).detail-link #{categoria.name}

            if session && session.usuario && session.usuario.funcao === 'admin'
              .admin-actions
                a(href="/products/" + product.id + "/edit").btn.btn-edit Editar Praga
                
                form(method="POST", action="/products/" + product.id + "?_method=DELETE", style="display:inline; margin:0;")
                  button(type="submit", onclick="return confirm('Tem certeza que deseja excluir esta praga?')").btn.btn-delete Excluir Praga

    footer.main-footer
      .container
        p &copy; 2025 PestControl Pro. Todos os direitos reservados.

     script.
      // Espera o documento carregar
      document.addEventListener('DOMContentLoaded', function() {
        const mainImage = document.getElementById('galleryMainImage');
        const thumbnails = document.querySelectorAll('.gallery-thumbnail');

        if (mainImage && thumbnails.length > 0) {
          thumbnails.forEach(function(thumb) {
            thumb.addEventListener('click', function() {

              thumbnails.forEach(t => t.classList.remove('active'));
              
              this.classList.add('active');
              
              mainImage.src = this.src;
            });
          });
        }
      });