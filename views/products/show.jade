doctype html
html(lang="pt-BR")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    //- O título será preenchido dinamicamente pelo backend
    title #{product.name} | Catálogo de Pragas - PestControl Pro
    style.
      :root {
          --primary-color: #2a7a3e; --secondary-color: #ff9800; --dark-color: #333333;
          --light-color: #f4f4f4; --background-color: #ffffff; --border-color: #ddd;
          --danger-color: #dc3545; --info-color: #007bff;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          line-height: 1.6; color: var(--dark-color); background-color: var(--light-color);
      }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
      .btn {
          display: inline-block; padding: 10px 24px; color: #fff; text-decoration: none;
          border-radius: 5px; font-weight: bold; transition: background-color 0.3s ease, transform 0.08s ease;
          cursor: pointer; border: none; font-size: 1rem;
          /* Default button background so buttons (like Favoritar) are visible */
          background-color: var(--primary-color);
      }
      .btn:hover { transform: translateY(-1px); background-color: #1e5a2d; }
      .main-header { background-color: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
      .main-nav { display: flex; justify-content: space-between; align-items: center; height: 70px; }
      .main-nav .logo { font-size: 1.5rem; font-weight: bold; color: var(--primary-color); text-decoration: none; }
      .main-nav ul { list-style: none; display: flex; align-items: center; }
      .main-nav ul li { margin-left: 20px; }
      .main-nav ul a { text-decoration: none; color: var(--dark-color); font-weight: 500; }
      .main-nav ul a.logout-btn { color: var(--secondary-color); font-weight: bold; }
      
      /* --- Estilos para Usuário Logado (Adicionado) --- */
      .user-greeting { margin-right: 15px; font-weight: 500; }
      a.logout-btn {
          background-color: var(--primary-color); color: #fff; padding: 8px 16px;
          border-radius: 5px; font-weight: bold;
      }
      a.logout-btn:hover { background-color: #1e5a2d; color: #fff; }
      
      main { padding: 60px 0; }
      .pest-detail-layout {
          display: grid; grid-template-columns: 1fr 1.5fr;
          gap: 40px; align-items: flex-start;
      }
      .gallery-container {
        width: 100%;
      }
      .gallery-main-image{
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        background-color: #eee;
        margin-bottom: 15px;
        border: 1px solid var(--border-color);
      }
      .gallery-thumbnails {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 10px;
      }
      .gallery-thumbnail {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 5px;
        cursor: pointer;
        border: 2px solid transparent;
        transition: border-color 0.3s ease, transform 0.3s ease;
      }
      .gallery-thumbnail:hover {
        transform: scale(1.05);
        border-color: var(--primary-color);
      }
      .gallery-thumbnail.active {
        border-color: var(--primary-color);
        box-shadow: 0 0 10px rgba(42, 122, 62, 0.5);
      }
      
      /* Video Player Styles */
      .video-container {
        width: 100%;
        margin-top: 20px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      }
      .video-container iframe {
        width: 100%;
        height: 315px;
        border: none;
      }
      
      /* Lightbox Styles */
      .lightbox {
        display: none;
        position: fixed;
        z-index: 9999;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.9);
        justify-content: center;
        align-items: center;
      }
      .lightbox.active {
        display: flex;
      }
      .lightbox-content {
        position: relative;
        max-width: 90%;
        max-height: 90%;
      }
      .lightbox-image {
        max-width: 100%;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 8px;
      }
      .lightbox-caption {
        position: absolute;
        bottom: -40px;
        left: 0;
        right: 0;
        text-align: center;
        color: #fff;
        font-size: 1.1rem;
        padding: 10px;
      }
      .lightbox-close {
        position: absolute;
        top: 20px;
        right: 40px;
        font-size: 40px;
        color: #fff;
        cursor: pointer;
        font-weight: bold;
        transition: color 0.3s;
      }
      .lightbox-close:hover {
        color: var(--secondary-color);
      }
      .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        font-size: 50px;
        color: #fff;
        cursor: pointer;
        user-select: none;
        padding: 20px;
        transition: color 0.3s;
      }
      .lightbox-nav:hover {
        color: var(--secondary-color);
      }
      .lightbox-prev {
        left: 20px;
      }
      .lightbox-next {
        right: 20px;
      }

      /* Seção de Métodos de Controle */
      .control-methods-section {
        margin-top: 40px;
        padding: 30px;
        background-color: #f9f9f9;
        border-radius: 8px;
        border: 2px solid var(--primary-color);
      }
      .control-methods-section h2 {
        font-size: 2rem;
        color: var(--primary-color);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .control-methods-section h2::before {
        content: "🛡️";
        font-size: 2rem;
      }
      .control-methods-section .subtitle {
        color: #666;
        font-size: 1rem;
        margin-bottom: 25px;
      }
      .method-card {
        background-color: #fff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 20px;
      }
      .method-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
      }
      .method-title {
        font-size: 1.5rem;
        color: var(--primary-color);
        font-weight: bold;
        flex: 1;
      }
      .time-badge {
        background-color: var(--secondary-color);
        color: #fff;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.9rem;
        white-space: nowrap;
      }
      .method-description {
        color: #555;
        line-height: 1.8;
        margin-bottom: 20px;
      }
      .steps-container {
        background-color: #f0f7f4;
        padding: 20px;
        border-radius: 8px;
        border-left: 4px solid var(--primary-color);
      }
      .steps-title {
        font-size: 1.2rem;
        color: var(--dark-color);
        font-weight: bold;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .steps-title::before {
        content: "📋";
      }
      .step-item {
        padding: 12px 0;
        border-bottom: 1px solid #ddd;
        line-height: 1.6;
        color: #333;
      }
      .step-item:last-child {
        border-bottom: none;
      }
      .step-number {
        display: inline-block;
        background-color: var(--primary-color);
        color: #fff;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        text-align: center;
        line-height: 28px;
        font-weight: bold;
        margin-right: 10px;
      }
      .no-method-message {
        text-align: center;
        padding: 40px;
        color: #999;
        font-style: italic;
      }

      .pest-info .pest-title { font-size: 2.5rem; margin-bottom: 5px; color: var(--dark-color); }
      .pest-info .pest-scientific-name { font-size: 1.2rem; font-style: italic; color: #666; margin-bottom: 30px; display: block; }
      .detail-section { margin-bottom: 30px; }
      .detail-section h3 {
          font-size: 1.3rem; color: var(--primary-color); margin-bottom: 10px;
          padding-bottom: 5px; border-bottom: 2px solid var(--border-color);
      }
      
      /* --- NOVO ESTILO ADICIONADO --- */
      .detail-link {
        display: inline-block;
        background-color: var(--primary-color);
        color: #fff;
        padding: 5px 12px;
        border-radius: 15px; /* Deixa com formato de "pílula" */
        text-decoration: none;
        font-weight: 500;
        transition: background-color 0.3s ease;
      }
      .detail-link:hover {
        background-color: #1e5a2d; /* Verde mais escuro no hover */
        color: #fff;
      }

      .admin-actions {
          margin-top: 30px; padding: 20px; background-color: #f9f9f9;
          border-radius: 8px; border: 1px solid var(--border-color); display: flex; gap: 15px; align-items: center;
      }
      .btn-edit { background-color: var(--info-color); }
      .btn-edit:hover { background-color: #0056b3; }
      .btn-delete { background-color: var(--danger-color); }
      .btn-delete:hover { background-color: #c82333; }
      .main-footer { background-color: var(--dark-color); color: #fff; text-align: center; padding: 30px 0; margin-top: 60px; }

      @media (max-width: 800px) {
         .pest-detail-layout { grid-template-columns: 1fr; }
        }

      @media (max-width: 768px) {
          h1, .pest-info .pest-title { font-size: 2.2rem; }
          h2 { font-size: 1.8rem; }
          .main-nav { flex-direction: column; height: auto; padding: 15px 0; }
          .main-nav ul { margin-top: 15px; flex-direction: column; align-items: center; gap: 10px; }
          .main-nav ul li { margin: 10px 0; margin-left: 0; }
          .admin-actions { flex-direction: column; align-items: stretch; } /* Empilha botões de admin */
          .admin-actions form, .admin-actions a { width: 100%; }
          .admin-actions button, .admin-actions a { width: 100%; text-align: center; }
      }

  body
    header.main-header
      nav.main-nav.container
        a(href="/").logo PestControl Pro
        ul
          if session && session.usuario && session.usuario.funcao ==='admin'
            li: a(href="/dashboardadmin") Dashboard
            li: a(href="/products/new") Nova Praga
            li: a(href="/metodo/new") Novo Método
            li: a(href="/categoria/new") Nova Categoria

          li: a(href="/nossosprodutos") Pragas
          li: a(href="/nossascategorias") Categorias
          li: a(href="/nossosmetodos") Métodos

          if !session.usuario
            li: a(href="/login").btn Entrar
          else
            li.user-greeting Olá, #{session.usuario.usuario}!
            li: a(href="/logout").logout-btn Sair


    main
      .container
        .pest-detail-layout
          .gallery-container 
            img(src=(gallery.length>0 ? gallery[0] : "http://placehold.co/400x300/f0f0f0/aaa?text=N/A"), alt=product.name, id="galleryMainImage", style="cursor: pointer;").gallery-main-image

            if gallery.length > 1
              .gallery-thumbnails 
                each imageUrl, index in gallery 
                  img(src=imageUrl, alt='Visualização ' + (index +1), data-index=index).gallery-thumbnail(class=(index === 0 ? 'active' : ''))
            
            // Video Player Section
            if embedVideoUrl
              .video-container
                iframe(src=embedVideoUrl, allowfullscreen, allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture")

          // Coluna de Informações
          .pest-info
            h1.pest-title= product.name
            span.pest-scientific-name= product.name2

            .detail-section
              h3 Descrição
              p= product.description
            
            .detail-section
              h3 Ciclo de Vida
              p= product.life_cycle
            
            .detail-section
              h3 Danos e Riscos
              p= product.damage
            
            if metodo && metodo.id 
              .detail-section 
              h3 Método 
              a(href="/metodo/" + metodo.id).detail-link #{metodo.name}

            if categoria && categoria.id 
              .detail-section 
              h3 Categoria 
              a(href="/categoria/" + categoria.id).detail-link #{categoria.name}

            if session && session.usuario && session.usuario.funcao === 'admin'
              .admin-actions
                a(href="/products/" + product.id + "/edit").btn.btn-edit Editar Praga
                
                form(method="POST", action="/products/" + product.id + "?_method=DELETE", style="display:inline; margin:0;")
                  button(type="submit", onclick="return confirm('Tem certeza que deseja excluir esta praga?')").btn.btn-delete Excluir Praga

        // Seção de Métodos de Controle/Soluções
        .control-methods-section
          h2 💡 Como Resolver Este Problema
          p.subtitle Soluções práticas e passo a passo para você controlar essa praga de forma eficaz
          
          if metodo && metodo.passo_a_passo
            .method-card
              .method-header
                h3.method-title= metodo.name
                if metodo.tempo_solucao
                  .time-badge ⏱️ #{metodo.tempo_solucao}
              
              if metodo.description
                p.method-description= metodo.description
              
              if metodo.passo_a_passo
                .steps-container
                  .steps-title Passo a Passo
                  - var steps = metodo.passo_a_passo.split('\n').filter(s => s.trim())
                  each step, index in steps
                    .step-item
                      span.step-number= index + 1
                      span= step.replace(/^\d+\.\s*/, '')
          else
            .no-method-message
              p 📌 Ainda não há métodos de controle cadastrados para esta praga.
              if session && session.usuario && session.usuario.funcao === 'admin'
                p
                  a(href="/metodo/new") Cadastre um método agora
        
        // Seção de Favoritar
        .container
          if session && session.usuario
            .detail-section
              button#favoriteBtn.btn(type="button" data-id=product.id data-loggedin="true") Favoritar
          else
            .detail-section
              p.login-required
                a(href="/login") Faça login
                span  para favoritar pragas
    
    // Lightbox for fullscreen image viewing
    #lightbox.lightbox
      span.lightbox-close ×
      span.lightbox-nav.lightbox-prev ‹
      span.lightbox-nav.lightbox-next ›
      .lightbox-content
        img#lightboxImage.lightbox-image(src="", alt="")
        .lightbox-caption#lightboxCaption

    footer.main-footer
      .container
        p &copy; 2025 PestControl Pro. Todos os direitos reservados.

     script.
      // Gallery data for lightbox
      const galleryImages = !{JSON.stringify(gallery || [])};
      let currentImageIndex = 0;

      // Espera o documento carregar
      document.addEventListener('DOMContentLoaded', function() {
        const mainImage = document.getElementById('galleryMainImage');
        const thumbnails = document.querySelectorAll('.gallery-thumbnail');
        const lightbox = document.getElementById('lightbox');
        const lightboxImage = document.getElementById('lightboxImage');
        const lightboxCaption = document.getElementById('lightboxCaption');
        const lightboxClose = document.querySelector('.lightbox-close');
        const lightboxPrev = document.querySelector('.lightbox-prev');
        const lightboxNext = document.querySelector('.lightbox-next');

        // Gallery thumbnail functionality
        if (mainImage && thumbnails.length > 0) {
          thumbnails.forEach(function(thumb) {
            thumb.addEventListener('click', function() {
              thumbnails.forEach(t => t.classList.remove('active'));
              this.classList.add('active');
              mainImage.src = this.src;
              currentImageIndex = parseInt(this.dataset.index);
            });
          });
        }

        // Lightbox functionality
        function openLightbox(index) {
          if (galleryImages.length === 0) return;
          currentImageIndex = index;
          lightboxImage.src = galleryImages[currentImageIndex];
          lightboxCaption.textContent = 'Imagem ' + (currentImageIndex + 1) + ' de ' + galleryImages.length;
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          lightbox.classList.remove('active');
          document.body.style.overflow = 'auto';
        }

        function showPrevImage() {
          currentImageIndex = (currentImageIndex - 1 + galleryImages.length) % galleryImages.length;
          lightboxImage.src = galleryImages[currentImageIndex];
          lightboxCaption.textContent = 'Imagem ' + (currentImageIndex + 1) + ' de ' + galleryImages.length;
        }

        function showNextImage() {
          currentImageIndex = (currentImageIndex + 1) % galleryImages.length;
          lightboxImage.src = galleryImages[currentImageIndex];
          lightboxCaption.textContent = 'Imagem ' + (currentImageIndex + 1) + ' de ' + galleryImages.length;
        }

        // Main image click to open lightbox
        if (mainImage) {
          mainImage.addEventListener('click', function() {
            openLightbox(currentImageIndex);
          });
        }

        // Thumbnail click to open lightbox
        thumbnails.forEach(function(thumb) {
          thumb.addEventListener('dblclick', function() {
            openLightbox(parseInt(this.dataset.index));
          });
        });

        // Lightbox controls
        if (lightboxClose) {
          lightboxClose.addEventListener('click', closeLightbox);
        }

        if (lightboxPrev) {
          lightboxPrev.addEventListener('click', showPrevImage);
        }

        if (lightboxNext) {
          lightboxNext.addEventListener('click', showNextImage);
        }

        // Close lightbox on background click
        if (lightbox) {
          lightbox.addEventListener('click', function(e) {
            if (e.target === lightbox) {
              closeLightbox();
            }
          });
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
          if (!lightbox.classList.contains('active')) return;
          
          if (e.key === 'Escape') {
            closeLightbox();
          } else if (e.key === 'ArrowLeft') {
            showPrevImage();
          } else if (e.key === 'ArrowRight') {
            showNextImage();
          }
        });
      });

      // Favorite button logic: server-backed for logged-in users
      (function(){
        const favBtn = document.getElementById('favoriteBtn');
        if (!favBtn) return;
        const id = String(favBtn.dataset.id);

        async function isServerFav(){
          try{
            const res = await fetch('/favoritos/data?mine=true');
            if (res.status === 401) return false;
            const data = await res.json();
            return Array.isArray(data.results) && data.results.some(p => String(p.id) === id);
          }catch(e){ return false; }
        }

        function updateBtn(isFav){
          if(isFav){
            favBtn.textContent = 'Remover dos Favoritos';
            favBtn.classList.add('btn-edit');
          } else {
            favBtn.textContent = 'Favoritar';
            favBtn.classList.remove('btn-edit');
          }
        }

        favBtn.addEventListener('click', async function(){
          try{
            // Check current state
            const current = await isServerFav();
            let res;
            if(!current){
              res = await fetch('/favoritos/' + id, { method: 'POST', headers: { 'Accept': 'application/json' } });
            } else {
              res = await fetch('/favoritos/' + id, { method: 'DELETE', headers: { 'Accept': 'application/json' } });
            }
            if(!res.ok) throw new Error('server_error');
            // Update UI
            updateBtn(!current);
          }catch(err){
            console.error('Erro ao atualizar favorito', err);
            alert('Erro ao atualizar favoritos. Por favor, tente novamente.');
          }
        });

        // Load initial state
        (async function(){
          const sf = await isServerFav();
          updateBtn(sf);
        })();
      })();