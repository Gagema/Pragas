extends ../layout

block content
  style.
      :root {
          --primary-color: #2a7a3e;
          --secondary-color: #ff9800;
          --dark-color: #333333;
          --light-color: #f4f4f4;
          --background-color: #ffffff;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
          line-height: 1.6;
          color: var(--dark-color);
          background-color: var(--light-color);
      }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
      
      /* Header */
      .page-header {
          background: linear-gradient(135deg, var(--primary-color) 0%, #1e5a2d 100%);
          color: #fff;
          padding: 40px 20px;
          text-align: center;
      }
      .page-header h1 {
          font-size: 2.2rem;
          margin-bottom: 10px;
          color: #fff;
      }
      .page-header p {
          font-size: 1.1rem;
          opacity: 0.95;
      }
      
      /* Imagem Analisada */
      .analyzed-image-section {
          background: var(--background-color);
          padding: 30px;
          margin: 30px auto;
          border-radius: 12px;
          box-shadow: 0 4px 20px rgba(0,0,0,0.1);
          text-align: center;
      }
      .analyzed-image-section h2 {
          color: var(--primary-color);
          margin-bottom: 20px;
      }
      .analyzed-image {
          max-width: 100%;
          max-height: 400px;
          border-radius: 8px;
          box-shadow: 0 4px 15px rgba(0,0,0,0.15);
      }
      
      /* Resultados */
      .results-section {
          margin: 40px auto;
      }
      .results-header {
          text-align: center;
          margin-bottom: 40px;
      }
      .results-header h2 {
          color: var(--primary-color);
          font-size: 2rem;
          margin-bottom: 10px;
      }
      .results-header p {
          color: #666;
          font-size: 1.1rem;
      }
      
      /* Cards de Resultado */
      .result-card {
          background: var(--background-color);
          border-radius: 12px;
          box-shadow: 0 4px 20px rgba(0,0,0,0.08);
          margin-bottom: 25px;
          overflow: hidden;
          transition: transform 0.3s ease, box-shadow 0.3s ease;
          border-left: 5px solid transparent;
      }
      .result-card:hover {
          transform: translateY(-3px);
          box-shadow: 0 8px 30px rgba(0,0,0,0.12);
      }
      .result-card.high-confidence {
          border-left-color: #4caf50;
      }
      .result-card.medium-confidence {
          border-left-color: var(--secondary-color);
      }
      .result-card.low-confidence {
          border-left-color: #f44336;
      }
      
      .result-content {
          display: grid;
          grid-template-columns: 200px 1fr auto;
          gap: 25px;
          padding: 25px;
          align-items: center;
      }
      
      .result-image-container {
          aspect-ratio: 4 / 3;
          overflow: hidden;
          border-radius: 8px;
          background: #f0f0f0;
      }
      .result-image {
          width: 100%;
          height: 100%;
          object-fit: cover;
      }
      .result-placeholder {
          width: 100%;
          height: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 3rem;
          background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
      }
      
      .result-info {
          flex: 1;
      }
      .result-rank {
          display: inline-block;
          background: var(--primary-color);
          color: #fff;
          padding: 5px 12px;
          border-radius: 20px;
          font-size: 0.85rem;
          font-weight: bold;
          margin-bottom: 10px;
      }
      .result-title {
          font-size: 1.4rem;
          color: var(--dark-color);
          margin-bottom: 5px;
          font-weight: 600;
      }
      .result-scientific {
          font-size: 1rem;
          color: #666;
          font-style: italic;
          margin-bottom: 10px;
      }
      .result-categoria {
          display: inline-block;
          background: var(--light-color);
          color: var(--dark-color);
          padding: 4px 12px;
          border-radius: 5px;
          font-size: 0.9rem;
          margin-bottom: 10px;
      }
      .result-reason {
          color: #777;
          font-size: 0.95rem;
          margin-top: 10px;
      }
      
      .result-confidence {
          text-align: center;
          min-width: 120px;
      }
      .confidence-circle {
          width: 100px;
          height: 100px;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          margin: 0 auto 15px;
          font-size: 1.8rem;
          font-weight: bold;
          color: #fff;
          box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      }
      .confidence-high { background: linear-gradient(135deg, #4caf50 0%, #66bb6a 100%); }
      .confidence-medium { background: linear-gradient(135deg, var(--secondary-color) 0%, #ffb74d 100%); }
      .confidence-low { background: linear-gradient(135deg, #f44336 0%, #ef5350 100%); }
      
      .confidence-label {
          font-size: 0.9rem;
          color: #666;
          margin-bottom: 15px;
      }
      .btn-details {
          display: inline-block;
          padding: 10px 20px;
          background: var(--primary-color);
          color: #fff;
          text-decoration: none;
          border-radius: 6px;
          font-weight: bold;
          transition: background 0.3s ease;
      }
      .btn-details:hover {
          background: #1e5a2d;
      }
      
      /* Ações */
      .actions-section {
          text-align: center;
          margin: 50px auto;
          padding: 30px;
          background: var(--background-color);
          border-radius: 12px;
      }
      .btn-new-analysis {
          display: inline-block;
          padding: 15px 35px;
          background: var(--secondary-color);
          color: #fff;
          text-decoration: none;
          border-radius: 8px;
          font-weight: bold;
          font-size: 1.1rem;
          transition: background 0.3s ease;
          margin-right: 15px;
      }
      .btn-new-analysis:hover {
          background: #e68900;
      }
      .btn-all-pragas {
          display: inline-block;
          padding: 15px 35px;
          background: #666;
          color: #fff;
          text-decoration: none;
          border-radius: 8px;
          font-weight: bold;
          font-size: 1.1rem;
          transition: background 0.3s ease;
      }
      .btn-all-pragas:hover {
          background: #555;
      }
      
      /* Disclaimer */
      .disclaimer {
          background: #fff3cd;
          border-left: 4px solid #ffc107;
          padding: 20px;
          margin: 30px auto;
          border-radius: 8px;
      }
      .disclaimer-icon {
          font-size: 1.5rem;
          margin-right: 10px;
      }
      .disclaimer p {
          margin: 0;
          color: #856404;
          font-size: 0.95rem;
      }
      
      /* Responsividade */
      @media (max-width: 768px) {
          .result-content {
              grid-template-columns: 1fr;
              text-align: center;
          }
          .result-image-container {
              max-width: 300px;
              margin: 0 auto;
          }
          .confidence-circle {
              margin: 15px auto;
          }
          .actions-section .btn-new-analysis,
          .actions-section .btn-all-pragas {
              display: block;
              margin: 10px auto;
              max-width: 300px;
          }
      }

  body
    main
      //- Cabeçalho
      section.page-header
        .container
          h1 ✅ Análise Concluída
          p Encontramos possíveis correspondências para a imagem enviada

      //- Imagem Analisada
      section.analyzed-image-section.container
        h2 📸 Imagem Analisada
        img.analyzed-image(src=imagemUpload, alt="Imagem analisada")

      //- Resultados
      section.results-section.container
        .results-header
          h2 🎯 Resultados da Identificação
          p #{resultados.length} #{resultados.length === 1 ? 'possível correspondência encontrada' : 'possíveis correspondências encontradas'}
        
        if resultados && resultados.length > 0
          each result, index in resultados
            - var confidenceClass = result.confianca >= 75 ? 'high-confidence' : result.confianca >= 50 ? 'medium-confidence' : 'low-confidence'
            - var confidenceCircleClass = result.confianca >= 75 ? 'confidence-high' : result.confianca >= 50 ? 'confidence-medium' : 'confidence-low'
            
            .result-card(class=confidenceClass)
              .result-content
                .result-image-container
                  if result.imageUrl
                    img.result-image(src=result.imageUrl, alt=result.name)
                  else
                    .result-placeholder 🐛
                
                .result-info
                  span.result-rank #{index + 1}º Resultado
                  h3.result-title= result.name
                  if result.name2
                    p.result-scientific= result.name2
                  if result.categoria_nome
                    span.result-categoria 📂 #{result.categoria_nome}
                  if result.razao
                    p.result-reason 💡 #{result.razao}
                
                .result-confidence
                  .confidence-circle(class=confidenceCircleClass)
                    | #{result.confianca}%
                  p.confidence-label Nível de Confiança
                  a.btn-details(href=`/products/${result.id}`) Ver Detalhes
        else
          .no-results
            p Nenhuma correspondência encontrada. Tente com outra imagem.

      //- Disclaimer
      section.disclaimer.container
        p
          span.disclaimer-icon ⚠️
          strong Importante: 
          | Os resultados são baseados em análise visual automatizada e devem ser usados como referência. 
          | Para identificação definitiva, consulte um especialista em agronomia ou entomologia.

      //- Ações
      section.actions-section.container
        h3 O que deseja fazer agora?
        p(style="margin-bottom: 25px;") Analise outra imagem ou explore nosso catálogo completo
        a.btn-new-analysis(href="/identificar") 📷 Nova Análise
        a.btn-all-pragas(href="/nossosprodutos") 🔍 Ver Todas as Pragas
