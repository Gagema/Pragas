{
  "apps": [{
    "name": "pestcontrol-pro",
    "script": "./bin/www",
    "instances": "max",
    "exec_mode": "cluster",
    "env": {
      "NODE_ENV": "development",
      "PORT": 3210
    },
    "env_production": {
      "NODE_ENV": "production",
      "PORT": 3210
    },
    "error_file": "./logs/pm2-error.log",
    "out_file": "./logs/pm2-out.log",
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
    "merge_logs": true,
    "autorestart": true,
    "watch": false,
    "max_memory_restart": "500M",
    "min_uptime": "10s",
    "max_restarts": 10,
    "restart_delay": 4000,
    "kill_timeout": 5000,
    "listen_timeout": 8000,
    "shutdown_with_message": true
  }]
}
