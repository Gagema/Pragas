# Configurações de Backup Automático
# Copie este arquivo para .env e ajuste as variáveis conforme necessário

# === Configurações do Banco de Dados ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=root
DB_PASSWORD=sua_senha_aqui

# === Configurações de Backup ===
# Diretório onde os backups serão armazenados
BACKUP_DIR=./backups/database

# Número de dias para manter backups antigos (serão deletados após esse período)
BACKUP_RETENTION_DAYS=30

# === Cron para Backup Automático (Linux/Mac) ===
# Adicione uma das linhas abaixo ao crontab para backup automático
# Execute: crontab -e

# Backup diário às 2:00 AM
# 0 2 * * * cd /caminho/para/projeto && ./scripts/backup.sh >> ./logs/backup.log 2>&1

# Backup a cada 6 horas
# 0 */6 * * * cd /caminho/para/projeto && ./scripts/backup.sh >> ./logs/backup.log 2>&1

# Backup semanal (domingo às 3:00 AM)
# 0 3 * * 0 cd /caminho/para/projeto && ./scripts/backup.sh >> ./logs/backup.log 2>&1

# === Tarefa Agendada (Windows) ===
# Use o Agendador de Tarefas do Windows para executar backup.bat
# Ou execute no PowerShell como administrador:

# Backup diário às 2:00 AM
# schtasks /create /tn "Backup Database" /tr "C:\caminho\para\projeto\scripts\backup.bat" /sc daily /st 02:00

# === Monitoramento e Notificações ===
# Para receber notificações de backup, configure:

# Email para notificações (implementação futura)
# BACKUP_NOTIFY_EMAIL=admin@example.com

# Webhook para notificações (Slack, Discord, etc.)
# BACKUP_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
